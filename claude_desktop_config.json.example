{
  "_comment": "Add this block to %APPDATA%\\Claude\\claude_desktop_config.json (Windows) or ~/Library/Application Support/Claude/claude_desktop_config.json (macOS)",
  "mcpServers": {
    "cloudthrift-demo": {
      "_comment": "Demo mode — synthetic data, no AWS credentials needed",
      "command": "cloudthrift",
      "args": [],
      "env": {
        "CLOUDTHRIFT_DEMO_MODE": "true"
      }
    },
    "cloudthrift": {
      "_comment": "Real AWS — set your profile/regions below",
      "command": "cloudthrift",
      "args": [],
      "env": {
        "CLOUDTHRIFT_DEMO_MODE": "false",
        "CLOUDTHRIFT_AWS_REGIONS": "[\"us-east-1\", \"us-west-2\"]",
        "AWS_PROFILE": "your-aws-profile"
      }
    }
  }
}
