# CloudThrift — Environment Configuration
# Copy to .env and fill in your values.
# All variables prefixed with CLOUDTHRIFT_ are picked up by pydantic-settings.

# ── AWS ────────────────────────────────────────────────────────────────────
# Comma-separated list of regions to scan.  Uses JSON list syntax.
CLOUDTHRIFT_AWS_REGIONS=["us-east-1", "us-west-2", "eu-west-1"]

# Optional: use a named AWS CLI profile
# CLOUDTHRIFT_AWS_PROFILE=my-finops-profile

# Optional: assume a cross-account IAM role before scanning
# CLOUDTHRIFT_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/CloudThriftReadOnly

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set to true to use synthetic data — no AWS credentials needed.
CLOUDTHRIFT_DEMO_MODE=false

# ── Scan thresholds ──────────────────────────────────────────────────────────
CLOUDTHRIFT_STOPPED_INSTANCE_AGE_DAYS=7
CLOUDTHRIFT_UNATTACHED_VOLUME_AGE_DAYS=3
CLOUDTHRIFT_OLD_SNAPSHOT_DAYS=90
CLOUDTHRIFT_S3_INACTIVE_DAYS=90
CLOUDTHRIFT_UNUSED_LAMBDA_DAYS=30
CLOUDTHRIFT_IDLE_ELB_REQUEST_THRESHOLD=100

# ── Safety ────────────────────────────────────────────────────────────────────
# Require explicit human approval before executing destructive remediation actions.
CLOUDTHRIFT_REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true
CLOUDTHRIFT_MAX_FINDINGS_PER_SCAN=500
